# Copy values into your shell / IDE run configuration (Spring reads real environment variables).
DB_URL=jdbc:postgresql://localhost:5432/booking
DB_USERNAME=booking
DB_PASSWORD=booking
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000
DDL_AUTO=update
SEED_ENABLED=true
SERVER_PORT=8080
